# LLM 默认配置 ==================================================
# 大模型 API
LLM_API_KEY=
# 大模型链接地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型型号
LLM_MODEL_ID=
# 超时时间（默认 60s）
LLM_TIMEOUT=60


# MinerU 配置 ==================================================
MINERU_API_TOKEN=



# Embedding 配置 ==================================================
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_EMBEDDING_MODEL=


# Chroma 配置 ==================================================
CHROMA_PERSIST_DIR=ChromaDB
CHROMA_COLLECTION_NAME=document_chunks


# Embedding 请求配置 ==================================================
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=60
# 关闭重复入库
CHROMA_FORCE_REEMBED=false
# chunk 级增量更新
CHROMA_SYNC_MODE=chunk


# 重试配置 ==================================================
# 开关，默认开，0为关
HTTP_RETRY_ENABLED=1
# 最大重试次数
HTTP_RETRY_MAX=3
# 基础退避秒数
HTTP_RETRY_BACKOFF=1.0
# 延迟上限
HTTP_RETRY_MAX_DELAY=32
# 重试日志（stderr）
HTTP_RETRY_LOG=1


# 评估机制 ==================================================
# 这个很消耗token，默认为关
RAGAS_EVAL_ENABLED=False